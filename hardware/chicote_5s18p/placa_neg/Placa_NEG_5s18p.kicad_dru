(version 1)

# =====================================================================
#  REGRAS - PLACA DE CELULAS 5s18p (Formula ITA, FSAE 2026) - rev C
#  F.Cu = ilhas de potencia 4 oz (TS). B.Cu = plano AGND + NTCs, mux, fusiveis e trilhas de sinal.
#  Placa toda do lado TS (isolacao TS/GLV no BMS, EV.7.5.7) -> tabela EV.6.5.7 nao se aplica.
# =====================================================================

# vao entre ilhas de potencia (EV.6.5.6 "clearly defined")
(rule "vao_entre_ilhas"
    (severity error)
    (constraint clearance (min 2.5mm))
    (condition "A.Net != B.Net && (A.NetName == 'P1' || A.NetName == 'P2' || A.NetName == 'P3' || A.NetName == 'P4' || A.NetName == 'P5' || A.NetName == 'P6') && (B.NetName == 'P1' || B.NetName == 'P2' || B.NetName == 'P3' || B.NetName == 'P4' || B.NetName == 'P5' || B.NetName == 'P6')"))

# qualquer coisa ligada a potencia (ilhas, fusiveis, sense de tensao) x resto: 0,5 mm (IPC-2221 B4, ate 100 V)
(rule "hv_x_resto"
    (severity error)
    (constraint clearance (min 0.5mm))
    (condition "(A.NetName == 'P1' || A.NetName == 'P2' || A.NetName == 'P3' || A.NetName == 'P4' || A.NetName == 'P5' || A.NetName == 'P6' || A.NetName == 'GND_ESD' || A.NetName == 'BATT1' || A.NetName == 'BATT2' || A.NetName == 'BATT12' || A.NetName == 'BATT13' || A.NetName == 'BATT14') && A.Net != B.Net"))

# dentro do LDO U3 (SOT-23-5, passo 0,95): entrada (no do modulo, ate 21 V) x GND. IPC-2221 B4 ate 30 V pede 0,13 mm -> 0,3 mm aqui
(rule "ldo_u3_interno"
    (severity error)
    (constraint clearance (min 0.3mm))
    (condition "A.insideCourtyard('U3') && B.insideCourtyard('U3')"))

(rule "sinal_largura"
    (constraint track_width (min 0.2mm)))

(rule "via"
    (constraint hole_size (min 0.4mm))
    (constraint via_diameter (min 0.8mm)))
