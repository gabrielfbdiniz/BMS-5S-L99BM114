# ==========================================
# KiCad EDA Git Ignore
# ==========================================
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
*.bak_*
*-backups/
*.lck
*.000
*.old
*.rpt
*.drc
_autosave-*
fp-info-cache

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
.history/
.claude/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ==========================================
# Python, Diagnostics & Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log
drc_report*.json
test_drc.json
scratch/
scripts/

# ==========================================
# Whitelist: Preserve Releases & Schematics
# ==========================================
!fabrication/
!fabrication/*.zip
!renders/*.png
!docs/*.pdf
